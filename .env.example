# ---------- 🌐 Server Configuration ----------
PORT=3000

# ---------- 📱 Meta / Instagram Developer Setup ----------
# Token สำหรับยืนยัน Webhook ตอนตั้งค่าใน Meta Developer Dashboard (ตั้งเองอะไรก็ได้ ยาวๆ ปลอดภัยไว้ก่อน)
VERIFY_TOKEN=your_secure_verify_token_here

# Instagram Graph API Access Token (ได้จาก Meta App / Facebook Graph API Explorer)
IG_ACCESS_TOKEN=your_instagram_access_token_here

# Instagram Page ID ของเพจที่ผูกกับบอท (ค่าเริ่มต้นหรือไอดีเพจตัวเอง)
IG_PAGE_ID=17841477196883165

# (ไม่บังคับ) App Secret จาก Meta App ใช้สำหรับตรวจลายเซ็นความปลอดภัยของ Webhook
APP_SECRET=your_meta_app_secret_here

# (เลือกใช้ได้) เวอร์ชั่น Graph API ของ Meta
GRAPH_VERSION=v21.0
IG_API_HOST=https://graph.facebook.com


# ---------- 🤖 AI Model Provider Configuration ----------
# เลือกค่าย AI ที่จะใช้งาน: "groq" (แนะนำ ตอบไว โควต้าถึก) หรือ "gemini"
MODEL_PROVIDER=groq

# ชื่อโมเดลที่จะใช้ (ถ้าเลือก groq แนะนำ qwen-2.5-32b หรือ llama-3.3-70b-versatile / ถ้าเลือก gemini ใส่ gemini-2.5-flash)
MODEL_NAME=qwen-2.5-32b

# API Key ของ Groq (สมัครฟรีที่ console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# API Key ของ Gemini (เผื่อวันไหนอยากสลับกลับไปใช้ค่ายเดิม)
GEMINI_API_KEY=AIza_your_gemini_api_key_here


# ---------- 🔍 Web Search Configuration ----------
# API Key ของ Tavily Search (สมัครรับฟรี 1,000 requests/เดือน ที่ tavily.com)
# ใช้สำหรับคำสั่ง !ค้นหา(เนื้อหา) ในแชท IG
TAVILY_API_KEY=tvly-your_tavily_api_key_here
